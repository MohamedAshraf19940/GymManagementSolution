@model GymManagement.BLL.ViewModels.MemberShipViewModels.MemberShipViewModel

@{
    ViewData["Title"] = "Membership Details";
}

<h1>Membership Details</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <dl class="row">

            <dt class="col-sm-4">Member Name</dt>
            <dd class="col-sm-8">@Model.MemberName</dd>

            <dt class="col-sm-4">Plan Name</dt>
            <dd class="col-sm-8">@Model.PlanName</dd>

            <dt class="col-sm-4">Plan Price</dt>
            <dd class="col-sm-8">@Model.PlanPrice</dd>

            <dt class="col-sm-4">Duration</dt>
            <dd class="col-sm-8">@Model.DurationDays Days</dd>

            <dt class="col-sm-4">Start Date</dt>
            <dd class="col-sm-8">@Model.StartDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-4">End Date</dt>
            <dd class="col-sm-8">@Model.EndDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
                @if (Model.Status == "Active")
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-danger">Expired</span>
                }
            </dd>

        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Index" class="btn btn-secondary">
            Back to List
        </a>

    </div>
</div>
