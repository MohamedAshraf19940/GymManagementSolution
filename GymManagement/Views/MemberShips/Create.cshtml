@model GymManagement.BLL.ViewModels.MemberShipViewModels.MemberShipViewModel

@{
    ViewData["Title"] = "Create Membership";
}

<h1>Create Membership</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="MemberId" class="form-label">Member</label>
                <select asp-for="MemberId"
                        class="form-select"
                        asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Members, "Id", "Name"))">
                    <option value="">-- Select Member --</option>
                </select>
                <span asp-validation-for="MemberId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PlanId" class="form-label">Plan</label>
                <select asp-for="PlanId"
                        class="form-select"
                        asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Plans, "Id", "Name"))">
                    <option value="">-- Select Plan --</option>
                </select>
                <span asp-validation-for="PlanId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Create
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Back to List
            </a>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
